{
  "name": "return-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:split && npm run validate:content && npm run validate:deep && npm run validate:full && tsc --noEmit && vite build",
    "content:split": "node scripts/split-curriculum.mjs",
    "content:full": "python scripts/build_full_readings.py && python scripts/enhance_learning_content.py && python scripts/convert_math_visuals.py",
    "preview": "vite preview",
    "validate:curriculum": "node scripts/validate-curriculum.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:deep": "tsx scripts/validate-deep-content.ts",
    "validate:full": "node scripts/validate-full-content.mjs"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "@vitejs/plugin-react": "^5.0.4",
    "katex": "^0.18.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.13"
  }
}
